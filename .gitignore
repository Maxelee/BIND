# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Large caches & run outputs (regenerable; kept on disk, never versioned)
# ---------------------------------------------------------------------------
analysis_physics_cache/
analysis_physics_cache
*_cache/
# tools/paper_cache/ is the paper-figure cache *builder* (source code), not a data
# cache — keep it tracked despite the *_cache/ rule above.
!tools/paper_cache/
outputs/
docs/_build/
examples/bind_output/

# ---------------------------------------------------------------------------
# Generated numerical data products (numpy dumps, etc.)
# ---------------------------------------------------------------------------
*.npz
*.npy
# Allow the bundled demo input + bundled package assets.
!examples/data/dmo_sample.npz
!src/bind/assets/*
# WL-emulator bundled data: held-out validation predictions + sample kappa maps
# used by examples/wlemu_tutorial.ipynb (see docs/wl_emulator.md).
!examples/data/wlemu_validation.npz
!examples/data/kappa_sample.npz
# WL-emulator reduced-feedback-space direction vectors (g_fgas etc.), used by
# examples/wlemu_tutorial.ipynb section 7 (see docs/wl_emulator.md).
!examples/data/wlemu_phys_dirs.npz

# ---------------------------------------------------------------------------
# Run logs
# ---------------------------------------------------------------------------
*.log

# ---------------------------------------------------------------------------
# Generated figures. Existing committed figures stay tracked; new figures
# (and the figure directories below) are kept on disk but not versioned.
# ---------------------------------------------------------------------------
*.pdf
*.png
*.gif
figures/
figures
paper_figures/
paper_figures
paper_figures_thermo/
paper_figures_thermo
*_figs/
*_figs
# ...but the paper-figure *builder scripts* are source, not artifacts:
!tools/paper_cache/referee_figs/
tools/paper_cache/referee_figs/*
!tools/paper_cache/referee_figs/*.py
!tools/paper_cache/referee_figs/*.tex
imgs
# Allow figures/gifs that live under the documentation static directory.
!docs/_static/**

# ---------------------------------------------------------------------------
# Downloaded papers / extracted scratch
# ---------------------------------------------------------------------------
aa53256-24.txt

# ---------------------------------------------------------------------------
# File / notebook backups
# ---------------------------------------------------------------------------
*.bak_pre_*
*.BACKUP.ipynb

# ---------------------------------------------------------------------------
# Machine-local config
# ---------------------------------------------------------------------------
.claude/settings.local.json

# ---------------------------------------------------------------------------
# Stale / scratch large artifacts (kept on disk, never versioned)
# ---------------------------------------------------------------------------
stale/

# ---------------------------------------------------------------------------
# Downloaded pretrained checkpoints (fetched via tools/download_weights.py)
# ---------------------------------------------------------------------------
weights/

# ---------------------------------------------------------------------------
# Unpublished research planning (private — this repo is PUBLIC; plans sync
# between systems via a private channel, never through origin)
# ---------------------------------------------------------------------------
plans/

# ---------------------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------------------
.DS_Store
docs/_build/

# Build artifacts (build/lib/** was committed on the lightcone branch and went
# stale against src/, shipping two copies of the paste configuration with
# opposite defaults -- never track these).
build/
dist/
*.egg-info/
.eggs/
.ruff_cache/
.pytest_cache/
dist_ci/

# LaTeX intermediates
*.aux
*.bbl
*.blg
*.out
*.synctex.gz
