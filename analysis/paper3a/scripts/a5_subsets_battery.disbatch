# WP-A5 probe-subset recovery batteries: 32 independent single-core tasks
# (16 kszonly + 16 joint injections). Each task runs one inject-and-recover
# MCMC (64 walkers x 1500 steps) and writes a parts json; the sbatch driver
# assembles + scores after the disBatch returns. Resumable at the parts
# level (re-running a task overwrites its own json only).
#DISBATCH PREFIX ( cd /mnt/home/mlee1/vdm_bind2-paper3a && module load gcc && source /mnt/home/mlee1/venvs/torch3/bin/activate && export OMP_NUM_THREADS=1 &&
#DISBATCH SUFFIX  ) &> /mnt/home/mlee1/ceph/logs/a5_subsets/battery_${DISBATCH_TASKID}.log
#DISBATCH PERENGINE START mkdir -p /mnt/home/mlee1/ceph/logs/a5_subsets
python -u analysis/paper3a/scripts/run_a5_recovery_subsets.py --which kszonly --inject-index 0
