# BIND Paper 3 house style (both papers A and B).
# Derived from the Paper-2 figure look + the Okabe-Ito role palette
# (validated CVD-safe 2026-07-18; see analysis/paper3a/style/__init__.py
# for roles and FIGURE_STYLE.md in the plans repo for the guide).

# --- typography: serif text + STIX math, no LaTeX dependency ---------------
font.family:         serif
font.serif:          STIXGeneral, DejaVu Serif
mathtext.fontset:    stix
font.size:           9
axes.titlesize:      9
axes.labelsize:      9
xtick.labelsize:     8
ytick.labelsize:     8
legend.fontsize:     7.5

# --- axes & ticks: quiet frame, ticks in, all four sides -------------------
axes.linewidth:      0.8
axes.grid:           False
xtick.direction:     in
ytick.direction:     in
xtick.top:           True
ytick.right:         True
xtick.minor.visible: True
ytick.minor.visible: True
xtick.major.size:    4.0
ytick.major.size:    4.0
xtick.minor.size:    2.2
ytick.minor.size:    2.2
xtick.major.width:   0.8
ytick.major.width:   0.8

# --- marks -----------------------------------------------------------------
lines.linewidth:     1.6
lines.markersize:    6
errorbar.capsize:    2.5
axes.prop_cycle:     cycler('color', ['0072B2', 'D55E00', '009E73', 'E69F00', '56B4E9', 'CC79A7'])

# --- legend: frameless, tight ----------------------------------------------
legend.frameon:      False
legend.handlelength: 1.6
legend.handletextpad: 0.5
legend.labelspacing: 0.35
legend.borderaxespad: 0.4

# --- figure & output -------------------------------------------------------
figure.dpi:          150
savefig.dpi:         300
savefig.bbox:        tight
savefig.pad_inches:  0.02
pdf.fonttype:        42
ps.fonttype:         42
