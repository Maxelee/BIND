\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces The per-halo $\to $ per-peak bridge, 1P feedback suite. \textit  {Left:} WL peak height excursion $\Delta \kappa /\kappa $ vs.\ the per-halo gas-mass excursion $\Delta \ln M_{\rm  gas}$; grey points are individual peaks, blue points are per-run means. The best-fit slope, $0.080$, matches the projected gas fraction of these halos; the per-peak correlation is $r=0.50$, while the run-averaged relation is clean. \textit  {Right:} the ejection--heating plane, $\Delta \ln M_{\rm  gas}$ (ejection, what $\kappa $ probes) vs.\ $\Delta \ln T$ (heating, the residual $y$ probes beyond mass loss), colored by $\Delta \ln Y$ (the total tSZ observable). This is the map-level realization of the $R(\nu )=f_{\rm  gas}\cdot T$ decomposition of Section~\ref {subsec:res2}.}}{9}{figure.5}\protected@file@percent }
\newlabel{fig:bridge_hero}{{5}{9}{The per-halo $\to $ per-peak bridge, 1P feedback suite. \textit {Left:} WL peak height excursion $\Delta \kappa /\kappa $ vs.\ the per-halo gas-mass excursion $\Delta \ln M_{\rm gas}$; grey points are individual peaks, blue points are per-run means. The best-fit slope, $0.080$, matches the projected gas fraction of these halos; the per-peak correlation is $r=0.50$, while the run-averaged relation is clean. \textit {Right:} the ejection--heating plane, $\Delta \ln M_{\rm gas}$ (ejection, what $\kappa $ probes) vs.\ $\Delta \ln T$ (heating, the residual $y$ probes beyond mass loss), colored by $\Delta \ln Y$ (the total tSZ observable). This is the map-level realization of the $\Rnu =\fgas \cdot T$ decomposition of Section~\ref {subsec:res2}}{figure.5}{}}
\citation{vanDaalen2020}
\citation{vanDaalen2020}
\citation{vanDaalen2020}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces The group-scale, van-Daalen-style bridge. \textit  {Left:} $S(\ell )$ suppression curves for the fiducial, lowest-$f_{\rm  gas}$, and highest-$f_{\rm  gas}$ 1P runs, showing the CIC-aliasing upturn at $\ell \gtrsim 2\times 10^4$ discussed in Section~\ref {subsec:caveats}. \textit  {Right:} $S(\ell )(\ell \sim 1500)$ vs.\ background-subtracted group gas fraction ($M_{200c}=1$--$3\times 10^{13}\,{\rm  M}_\odot /h$, $R_{500c}$) for 57 feedback-varied lightcones, colored by feedback family (AGN, SN/wind, other). The correlation is $r=0.91$. This is the direct analog, at the field level, of the van Daalen baryon-fraction--suppression relation \citep  {vanDaalen2020}.}}{10}{figure.6}\protected@file@percent }
\newlabel{fig:bridge_fgas}{{6}{10}{The group-scale, van-Daalen-style bridge. \textit {Left:} $\Sell $ suppression curves for the fiducial, lowest-$\fgas $, and highest-$\fgas $ 1P runs, showing the CIC-aliasing upturn at $\ell \gtrsim 2\times 10^4$ discussed in Section~\ref {subsec:caveats}. \textit {Right:} $\Sell (\ell \sim 1500)$ vs.\ background-subtracted group gas fraction ($\Mhalo =1$--$3\times 10^{13}\,\Msun /h$, $R_{500c}$) for 57 feedback-varied lightcones, colored by feedback family (AGN, SN/wind, other). The correlation is $r=0.91$. This is the direct analog, at the field level, of the van Daalen baryon-fraction--suppression relation \citep {vanDaalen2020}}{figure.6}{}}
