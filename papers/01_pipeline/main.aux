\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces The bridge fit separately in three $M_{200c}$ bins (group, intermediate, cluster). \textit  {(a)} $S(\ell )(\ell \sim 1500)$ vs.\ group $f_{\rm  gas}$ per mass bin. \textit  {(b)} Pearson $r$ and best-fit slope $\alpha =\partial S/\partial f_{\rm  gas}$ vs.\ mass-bin center. \textit  {(c)} $r[f_{\rm  gas},S(\ell )]$ vs.\ $\ell $ per mass bin. The correlation loosens toward cluster scale even as the slope steepens, consistent with the group-dominated suppression signal discussed in the text.}}{13}{figure.9}\protected@file@percent }
\newlabel{fig:bridge_mass}{{9}{13}{The bridge fit separately in three $M_{200c}$ bins (group, intermediate, cluster). \textit {(a)} $\Sell (\ell \sim 1500)$ vs.\ group $\fgas $ per mass bin. \textit {(b)} Pearson $r$ and best-fit slope $\alpha =\partial S/\partial \fgas $ vs.\ mass-bin center. \textit {(c)} $r[\fgas ,\Sell ]$ vs.\ $\ell $ per mass bin. The correlation loosens toward cluster scale even as the slope steepens, consistent with the group-dominated suppression signal discussed in the text}{figure.9}{}}
