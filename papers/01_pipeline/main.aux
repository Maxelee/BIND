\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces The Compton-$Y$ bridge resolves the tightest single-quantity predictor of the field-level suppression. \textit  {(a)} $S(\ell )(\ell \sim 1500)$ vs.\ $\log _{10}Y_{500c}^{\rm  group}$, $r=0.93$. \textit  {(b)} $Y_{500c}^{\rm  group}$ vs.\ group $f_{\rm  gas}$, $r=0.98$ --- the two are nearly degenerate at fixed mass and redshift. \textit  {(c)} raw and partial correlations with $S(\ell )$: $f_{\rm  gas}$ $0.91$, $\log Y$ $0.93$, $\log T$ $0.85$, $Y\,|\,f_{\rm  gas}$ (partial) $0.48$, $f_{\rm  gas}\,|\,Y$ (partial) $\approx 0$ --- $Y$ subsumes essentially all of the predictive power of $f_{\rm  gas}$ alone.}}{12}{figure.8}\protected@file@percent }
\newlabel{fig:bridge_compton_y}{{8}{12}{The Compton-$Y$ bridge resolves the tightest single-quantity predictor of the field-level suppression. \textit {(a)} $\Sell (\ell \sim 1500)$ vs.\ $\log _{10}Y_{500c}^{\rm group}$, $r=0.93$. \textit {(b)} $Y_{500c}^{\rm group}$ vs.\ group $\fgas $, $r=0.98$ --- the two are nearly degenerate at fixed mass and redshift. \textit {(c)} raw and partial correlations with $\Sell $: $\fgas $ $0.91$, $\log Y$ $0.93$, $\log T$ $0.85$, $Y\,|\,\fgas $ (partial) $0.48$, $\fgas \,|\,Y$ (partial) $\approx 0$ --- $Y$ subsumes essentially all of the predictive power of $\fgas $ alone}{figure.8}{}}
