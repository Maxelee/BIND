\citation{Arnaud2010}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Field-level fiducial closure: \textsc  {bind}{} (solid) vs.\ TNG300 hydrodynamical truth (dashed) for the convergence power spectrum $C_\ell ^{\kappa \kappa }$, peak counts $N_{\rm  peak}(\nu )$, minimum counts $N_{\rm  min}(\nu )$, and the three Minkowski functionals $V_0,V_1,V_2(\nu )$, with fractional residuals (shaded $\pm $ band) in the lower row. $C_\ell ^{\kappa \kappa }$ and the Minkowski functionals agree to within a few percent across the full range shown; peak counts show larger ($\sim \pm 15\%$) but statistically consistent scatter in their sparsely populated high-$\nu $ tail, while minimum counts stay within $\sim \pm 7\%$ across their full range. This is the headline result of the paper: at fixed subgrid parameters, the \textsc  {bind}{} lightcone is statistically indistinguishable from the true hydrodynamical lightcone across the full non-Gaussian statistic set used by Stage-IV WL analyses.}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:validation_field}{{2}{6}{Field-level fiducial closure: \bind {} (solid) vs.\ TNG300 hydrodynamical truth (dashed) for the convergence power spectrum $C_\ell ^{\kappa \kappa }$, peak counts $N_{\rm peak}(\nu )$, minimum counts $N_{\rm min}(\nu )$, and the three Minkowski functionals $V_0,V_1,V_2(\nu )$, with fractional residuals (shaded $\pm $ band) in the lower row. $C_\ell ^{\kappa \kappa }$ and the Minkowski functionals agree to within a few percent across the full range shown; peak counts show larger ($\sim \pm 15\%$) but statistically consistent scatter in their sparsely populated high-$\nu $ tail, while minimum counts stay within $\sim \pm 7\%$ across their full range. This is the headline result of the paper: at fixed subgrid parameters, the \bind {} lightcone is statistically indistinguishable from the true hydrodynamical lightcone across the full non-Gaussian statistic set used by Stage-IV WL analyses}{figure.2}{}}
\citation{bindII}
\citation{bindII}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Halo-level thermodynamic closure at snapshot 96 ($z\approx 0.03$). \textit  {Left:} the $Y_{500c}$--$M_{200c}$ relation, \textsc  {bind}{} (solid) vs.\ TNG300 hydrodynamical truth (dashed), with $1\sigma $ intrinsic-scatter bands overlapping across $10^{13}$--$10^{14.5}\,{\rm  M}_\odot /h$. \textit  {Middle:} the stacked electron-column ratio $\tau _{\rm  BIND}/\tau _{\rm  hydro}$ by mass bin, $\sim 1.05$--$1.15$ at group scale and closer to unity at the highest mass bin shown. \textit  {Right:} projected pressure profiles $y(r)/y(r_{500c})$ in four mass bins compared to the Arnaud et al.\ universal profile \citep  {Arnaud2010}, matching to $\sim 2\,r_{500c}$.}}{7}{figure.3}\protected@file@percent }
\newlabel{fig:validation_halo}{{3}{7}{Halo-level thermodynamic closure at snapshot 96 ($z\approx 0.03$). \textit {Left:} the $Y_{500c}$--$\Mhalo $ relation, \bind {} (solid) vs.\ TNG300 hydrodynamical truth (dashed), with $1\sigma $ intrinsic-scatter bands overlapping across $10^{13}$--$10^{14.5}\,\Msun /h$. \textit {Middle:} the stacked electron-column ratio $\tau _{\rm BIND}/\tau _{\rm hydro}$ by mass bin, $\sim 1.05$--$1.15$ at group scale and closer to unity at the highest mass bin shown. \textit {Right:} projected pressure profiles $y(r)/y(r_{500c})$ in four mass bins compared to the Arnaud et al.\ universal profile \citep {Arnaud2010}, matching to $\sim 2\,r_{500c}$}{figure.3}{}}
