\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Stacked $\tau (R)$ (left) and $y(R)$ (right) profiles for all 256 Sobol feedback nodes in the BGS host mass bin ($\log M_{200c}\in [13.4,13.8]$, $z=0.18$), colored by each node's gas fraction $\tilde  {f}_{\rm  gas,500}$; the fiducial TNG profile is overlaid in black. Bottom row: the ratio of the node-to-node spread to the fiducial profile as a function of radius, showing the feedback response is core-dominated. Takeaway: feedback reshapes both the $\tau $ and $y$ profiles smoothly and coherently with $\tilde  {f}_{\rm  gas}$, most strongly at small radius.}}{8}{figure.4}\protected@file@percent }
\newlabel{fig:responsefan}{{4}{8}{Stacked $\tau (R)$ (left) and $y(R)$ (right) profiles for all 256 Sobol feedback nodes in the BGS host mass bin ($\log \Mhalo \in [13.4,13.8]$, $z=0.18$), colored by each node's gas fraction $\tilde {f}_{\rm gas,500}$; the fiducial TNG profile is overlaid in black. Bottom row: the ratio of the node-to-node spread to the fiducial profile as a function of radius, showing the feedback response is core-dominated. Takeaway: feedback reshapes both the $\tau $ and $y$ profiles smoothly and coherently with $\fgt $, most strongly at small radius}{figure.4}{}}
