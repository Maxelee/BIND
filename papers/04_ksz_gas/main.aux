\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Forecast corner plot of the two feedback directions constrained by a future Simons Observatory/CMB-S4$\times $DESI joint kSZ (density, blue) $+$~tSZ (pressure, green) CAP analysis, compared to their joint combination (red). Takeaway: kSZ and tSZ alone each leave roughly one direction essentially unconstrained, but the joint combination pins both -- the two probes are complementary, not redundant, and the pinned directions coincide with the 2-D feedback latent of Figure~\ref {fig:latent}.}}{11}{figure.6}\protected@file@percent }
\newlabel{fig:moneyplot}{{6}{11}{Forecast corner plot of the two feedback directions constrained by a future Simons Observatory/CMB-S4$\times $DESI joint kSZ (density, blue) $+$~tSZ (pressure, green) CAP analysis, compared to their joint combination (red). Takeaway: kSZ and tSZ alone each leave roughly one direction essentially unconstrained, but the joint combination pins both -- the two probes are complementary, not redundant, and the pinned directions coincide with the 2-D feedback latent of Figure~\ref {fig:latent}}{figure.6}{}}
