\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}Comparison with the earlier estimate}{5}{subsection.3.2}\protected@file@percent }
\newlabel{sec:old}{{3.2}{5}{Comparison with the earlier estimate}{subsection.3.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces The corrected, faithful three-way comparison at the fiducial feedback point ($z_{\rm  s}=1$). \emph  {Left:} suppression $S(\ell )=C_\ell /C_\ell ^{\rm  dmo}$ for the full \textsc  {bind}{} field, the faithful radial-BCM-warp control, and the crude pure-spherical (monopole) control. \textsc  {bind}{} suppresses power well below either control at $\ell \gtrsim $ few$\times 10^3$, and the radial-BCM-warp control tracks \textsc  {bind}{} substantially more closely than the pure-spherical control does, by construction. \emph  {Center:} residual-field power for the total baryonic effect, the pure-spherical error, the faithful-BCM miss, and the triaxiality term. \emph  {Right:} the decomposition fractions $f_{\rm  aniso}$, $f_{\rm  tri}$, and $f_{\rm  mono}=f_{\rm  aniso}+f_{\rm  tri}$ vs.\ $\ell $ -- the corrected, missed-angular-structure fraction $f_{\rm  aniso}$ declines with scale while the triaxiality-tracing fraction $f_{\rm  tri}$ rises, so their sum reproduces the old, scale-flat estimate almost exactly. This is the headline figure of the Letter. }}{6}{figure.3}\protected@file@percent }
\newlabel{fig:decomposition}{{3}{6}{The corrected, faithful three-way comparison at the fiducial feedback point ($\zs =1$). \emph {Left:} suppression $S(\ell )=C_\ell /C_\ell ^{\rm dmo}$ for the full \bind {} field, the faithful radial-BCM-warp control, and the crude pure-spherical (monopole) control. \bind {} suppresses power well below either control at $\ell \gtrsim $ few$\times 10^3$, and the radial-BCM-warp control tracks \bind {} substantially more closely than the pure-spherical control does, by construction. \emph {Center:} residual-field power for the total baryonic effect, the pure-spherical error, the faithful-BCM miss, and the triaxiality term. \emph {Right:} the decomposition fractions $\faniso $, $\ftri $, and $\fmono =\faniso +\ftri $ vs.\^^M$\ell $ -- the corrected, missed-angular-structure fraction $\faniso $ declines with scale while the triaxiality-tracing fraction $\ftri $ rises, so their sum reproduces the old, scale-flat estimate almost exactly. This is the headline figure of the Letter}{figure.3}{}}
