\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Stacked profiles in the mass bin $[13.5,14.0)$: the tSZ $Y(r)$, the X-ray $S_X(r)$, and the target baryon fraction $f_{\mathrm  {b}}(r)$. The line is the median and the band the $16\text  {--}84\%$ spread across the $256$ feedback designs; the dotted line marks $f_{\mathrm  {cos}}$. The design-to-design variation at fixed mass is the conditional signal to be predicted.}}{3}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:profiles}{{1}{3}{Stacked profiles in the mass bin $[13.5,14.0)$: the tSZ $\Ysz (r)$, the X-ray $\Sx (r)$, and the target baryon fraction $\fb (r)$. The line is the median and the band the $16\text {--}84\%$ spread across the $256$ feedback designs; the dotted line marks $f_{\mathrm {cos}}$. The design-to-design variation at fixed mass is the conditional signal to be predicted}{figure.caption.1}{}}
