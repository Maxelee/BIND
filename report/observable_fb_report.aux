\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Validation against hydrodynamic truth}{4}{subsection.4.3}\protected@file@percent }
\newlabel{sec:truth}{{4.3}{4}{Validation against hydrodynamic truth}{subsection.4.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The joint distribution $p(f_{\mathrm  {b}}(r),Y(r))$ at $r=141\,h^{-1}\mathrm  {kpc}$ in the mass bin $[13.5,14.0)$: each point is one of the $256$ feedback designs, coloured by the supernova wind energy $E_{\rm  SN}$. The solid curve is the conditional mean $\mathbb  {E}[f_{\mathrm  {b}}\mid Y]$ learned by the regressor; the residual vertical width is the conditional scatter we report. Marginals are shown on the axes. A single feedback parameter does not cleanly order the locus---it is a $30$-dimensional space, and $Y$ captures the net effect.}}{5}{figure.caption.4}\protected@file@percent }
\newlabel{fig:joint}{{2}{5}{The joint distribution $p(\fb (r),\Ysz (r))$ at $r=141\,\hkpc $ in the mass bin $[13.5,14.0)$: each point is one of the $256$ feedback designs, coloured by the supernova wind energy $E_{\rm SN}$. The solid curve is the conditional mean $\E [\fb \mid \Ysz ]$ learned by the regressor; the residual vertical width is the conditional scatter we report. Marginals are shown on the axes. A single feedback parameter does not cleanly order the locus---it is a $30$-dimensional space, and $\Ysz $ captures the net effect}{figure.caption.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Noise-free $\mathrm  {RMS}\,|\hat  f_{\mathrm  {b}}-f_{\mathrm  {b}}|$ ($\times 10^{3}$) for predicting CAMELS hydrodynamic-truth $f_{\mathrm  {b}}(r)$, by feature set and mass bin. For scale, the truth $f_{\mathrm  {b}}$ spans $0.08\text  {--}0.18$ and $\sigma _{\rm  marg}(r)\simeq 0.02\text  {--}0.03$.}}{5}{table.caption.6}\protected@file@percent }
\newlabel{tab:truth}{{2}{5}{Noise-free $\mathrm {RMS}\,|\hat \fb -\fb |$ ($\times 10^{3}$) for predicting CAMELS hydrodynamic-truth $\fb (r)$, by feature set and mass bin. For scale, the truth $\fb $ spans $0.08\text {--}0.18$ and $\sigma _{\rm marg}(r)\simeq 0.02\text {--}0.03$}{table.caption.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4}Projection: the super-cosmic $f_{\mathrm  {b}}(r)$ is physical, not an artefact}{5}{subsection.4.4}\protected@file@percent }
\newlabel{sec:proj}{{4.4}{5}{Projection: the super-cosmic $\fb (r)$ is physical, not an artefact}{subsection.4.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Held-out-$\bm  {\theta }$ scatter reduction of the baryon-fraction profile $f_{\mathrm  {b}}(r)$ as a function of radius, for three nested observable sets, in three mass bins (shared vertical axis). The observable \emph  {profile} predicts $f_{\mathrm  {b}}(r)$ to $60\text  {--}90\%$ reduction, peaking in the feedback-active region and declining in the outskirts as $f_{\mathrm  {b}}\to f_{\mathrm  {cos}}$.}}{6}{figure.caption.5}\protected@file@percent }
\newlabel{fig:skill}{{3}{6}{Held-out-$\thetav $ scatter reduction of the baryon-fraction profile $\fb (r)$ as a function of radius, for three nested observable sets, in three mass bins (shared vertical axis). The observable \emph {profile} predicts $\fb (r)$ to $60\text {--}90\%$ reduction, peaking in the feedback-active region and declining in the outskirts as $\fb \to f_{\mathrm {cos}}$}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Validation on CAMELS hydrodynamic truth. Red: the stacked truth $f_{\mathrm  {b}}(r)$ with its cosmic-variance band (bootstrap over $26$ realisations). Black: the prediction from the truth $Y$ (dashed) and $Y{+}S_X$ (solid) profiles, using a map trained only on the BIND feedback designs. The map recovers the truth profile, including the evacuated core, to $\mathrm  {RMS}\simeq 0.004$.}}{6}{figure.caption.7}\protected@file@percent }
\newlabel{fig:realdata}{{4}{6}{Validation on CAMELS hydrodynamic truth. Red: the stacked truth $\fb (r)$ with its cosmic-variance band (bootstrap over $26$ realisations). Black: the prediction from the truth $\Ysz $ (dashed) and $\Ysz {+}\Sx $ (solid) profiles, using a map trained only on the BIND feedback designs. The map recovers the truth profile, including the evacuated core, to $\mathrm {RMS}\simeq 0.004$}{figure.caption.7}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.5}The result survives the background-nulled (CAP) estimator}{6}{subsection.4.5}\protected@file@percent }
\newlabel{sec:cap}{{4.5}{6}{The result survives the background-nulled (CAP) estimator}{subsection.4.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Differential vs.\ enclosed projected baryon fraction. The differential $f_{\mathrm  {b}}(r)$ at two LOS depths ($6.25$ and $50\,h^{-1}\mathrm  {Mpc}$) nearly coincide and overshoot the cosmic value (dotted) at intermediate radii---a real consequence of feedback gas redistribution. The enclosed $f_{\mathrm  {b}}(<r)$ (triangles) stays below cosmic; the vertical line marks the median $R_{200\mathrm  {c}}$. Shared vertical axis.}}{7}{figure.caption.8}\protected@file@percent }
\newlabel{fig:proj}{{5}{7}{Differential vs.\ enclosed projected baryon fraction. The differential $\fb (r)$ at two LOS depths ($6.25$ and $50\,\hMpc $) nearly coincide and overshoot the cosmic value (dotted) at intermediate radii---a real consequence of feedback gas redistribution. The enclosed $\fb (<r)$ (triangles) stays below cosmic; the vertical line marks the median $\Rtwo $. Shared vertical axis}{figure.caption.8}{}}
