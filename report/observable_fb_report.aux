\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Validation with CAP-filtered observables. \emph  {Top:} predicted vs.\ truth $f_{\mathrm  {b}}(r)$ using raw (dashed) and CAP (solid) $\{Y,S_X\}$ profiles; CAP still recovers the truth at a modest accuracy cost. \emph  {Bottom:} median per-measurement error vs.\ injected observational noise; raw and CAP degrade similarly, so CAP does not add per-bin-noise robustness. Shared vertical axes within each row.}}{8}{figure.caption.9}\protected@file@percent }
\newlabel{fig:cap}{{6}{8}{Validation with CAP-filtered observables. \emph {Top:} predicted vs.\ truth $\fb (r)$ using raw (dashed) and CAP (solid) $\{\Ysz ,\Sx \}$ profiles; CAP still recovers the truth at a modest accuracy cost. \emph {Bottom:} median per-measurement error vs.\ injected observational noise; raw and CAP degrade similarly, so CAP does not add per-bin-noise robustness. Shared vertical axes within each row}{figure.caption.9}{}}
